# Supabase — hébergement EU/Suisse
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Stripe — clé publique (safe pour le frontend web)
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# OpenAgenda — API d'événements
EXPO_PUBLIC_OPENAGENDA_API_KEY=your-openagenda-key

# Open-Meteo (météo, pas de clé requise pour le plan gratuit)
EXPO_PUBLIC_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# === Variables serveur uniquement (Edge Functions Supabase) ===
# Ne jamais exposer dans le bundle de l'app
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
OPENAI_API_KEY=sk-...
