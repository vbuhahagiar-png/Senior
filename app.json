{
  "expo": {
    "name": "Senior +",
    "slug": "senior-plus",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "seniorplus",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E8"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ch.seniorplus.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Senior + utilise votre caméra pour photographier vos courriers.",
        "NSMicrophoneUsageDescription": "Senior + utilise votre microphone pour le compagnon vocal.",
        "NSPhotoLibraryUsageDescription": "Senior + accède à vos photos pour partager avec votre famille."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F5F0E8"
      },
      "package": "ch.seniorplus.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "Senior +"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#8A9E85"
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
